{
  "schema_version": 1,
  "max_job_timeout_minutes": 60,
  "workflows": {
    ".github/workflows/audit.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      },
      "job_permissions": {
        "security-audit": {
          "owner": "pingora-panel-security",
          "reason": "rustsec/audit-check publishes a check run and files advisory issues on scheduled and push runs.",
          "expires_on": "2027-03-01",
          "permissions": {
            "checks": "write",
            "contents": "read",
            "issues": "write"
          }
        }
      }
    },
    ".github/workflows/build.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      }
    },
    ".github/workflows/coverage.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      }
    },
    ".github/workflows/docs.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      }
    },
    ".github/workflows/fuzz.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      }
    },
    ".github/workflows/mark-stale.yaml": {
      "cancel_in_progress": false,
      "permissions": {
        "issues": "write",
        "pull-requests": "write"
      }
    },
    ".github/workflows/panel-adapter.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      }
    },
    ".github/workflows/panel-deploy.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      }
    },
    ".github/workflows/panel-web.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      }
    },
    ".github/workflows/panel.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      }
    },
    ".github/workflows/pingora-upstream-canary.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      },
      "job_permissions": {
        "report": {
          "owner": "pingora-panel-platform",
          "reason": "A scheduled canary that fails opens or updates the compatibility issue the specification asks for, and closes it once the canary passes again.",
          "expires_on": "2027-03-01",
          "permissions": {
            "issues": "write"
          }
        }
      }
    },
    ".github/workflows/release.yml": {
      "cancel_in_progress": false,
      "permissions": {
        "contents": "read"
      },
      "job_permissions": {
        "image": {
          "owner": "pingora-panel-security",
          "reason": "Each platform's image is pushed to GHCR by digest so the index job can join, sign and attest exactly those digests.",
          "expires_on": "2027-03-01",
          "permissions": {
            "contents": "read",
            "packages": "write"
          }
        },
        "index": {
          "owner": "pingora-panel-security",
          "reason": "The image index is pushed to GHCR, signed without keys through the workflow's OIDC identity, and given provenance and SBOM attestations stored beside it.",
          "expires_on": "2027-03-01",
          "permissions": {
            "attestations": "write",
            "contents": "read",
            "id-token": "write",
            "packages": "write"
          }
        },
        "release": {
          "owner": "pingora-panel-security",
          "reason": "The release is created with its assets, each signed without keys through the workflow's OIDC identity and given a provenance attestation.",
          "expires_on": "2027-03-01",
          "permissions": {
            "attestations": "write",
            "contents": "write",
            "id-token": "write"
          }
        }
      }
    },
    ".github/workflows/secret-scan.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      }
    },
    ".github/workflows/semgrep.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      }
    },
    ".github/workflows/supply-chain.yml": {
      "cancel_in_progress": true,
      "permissions": {
        "contents": "read"
      }
    }
  }
}
