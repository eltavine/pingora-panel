# Starts the host agent once its credentials are issued, and restarts it
# with each renewal; systemd hands credentials over only at start.

[Unit]
Description=Pingora Panel host agent credentials

[Path]
PathChanged=/var/lib/pingora-panel/ops-agent/credentials/identity.pem
Unit=pingora-panel-ops-agent-credentials.service

[Install]
WantedBy=multi-user.target
