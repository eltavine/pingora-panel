# Settings of the Pingora Panel host agent (ADR 0030), installed as
# /etc/pingora-panel/ops-agent.env. Restart the agent after changing them.

# The trust domain of the installation's authority, as compose.yaml sets it.
PINGORA_PANEL_TRUST_DOMAIN=pingora-panel.internal

# The directories whose sizes the console shows: here the gateway's volumes
# in the Compose installation, which directories.conf lets the agent read.
# Unset all three to turn the capability off.
PINGORA_PANEL_OPS_CONFIGURATION_DIR=/var/lib/docker/volumes/pingora-panel_gateway-state/_data
PINGORA_PANEL_OPS_LOGS_DIR=/var/lib/docker/volumes/pingora-panel_gateway-logs/_data
PINGORA_PANEL_OPS_CERTIFICATES_DIR=/var/lib/docker/volumes/pingora-panel_gateway-secrets/_data
