# Settings of the Pingora Panel host agent (ADR 0030), installed as
# /etc/pingora-panel/ops-agent.env. Restart the agent after changing them.

# The trust domain of the installation's authority, as compose.yaml sets it.
PINGORA_PANEL_TRUST_DOMAIN=pingora-panel.internal

# The directories whose sizes the console shows. install.sh points them at
# the gateway's volumes where the engine keeps them; a directory set here
# takes precedence, and directories.conf must then let the agent read it:
#
# PINGORA_PANEL_OPS_CONFIGURATION_DIR=
# PINGORA_PANEL_OPS_LOGS_DIR=
# PINGORA_PANEL_OPS_CERTIFICATES_DIR=
