# The Pingora Panel host agent (ADR 0030). It starts once the installation's
# authority has issued its credentials; drop-ins grant each capability the
# privilege it needs.

[Unit]
Description=Pingora Panel host agent
Documentation=https://github.com/eltavine/pingora-panel/blob/main/docs/adr/0030-ops-agent.md
After=network.target
ConditionPathExists=/var/lib/pingora-panel/ops-agent/credentials/identity.pem

[Service]
Type=exec
ExecStart=/usr/local/bin/ops-agent
EnvironmentFile=-/etc/pingora-panel/ops-agent.env
LoadCredential=identity.pem:/var/lib/pingora-panel/ops-agent/credentials/identity.pem
LoadCredential=trust.pem:/var/lib/pingora-panel/ops-agent/credentials/trust.pem
Restart=on-failure
RestartSec=5s

DynamicUser=yes
User=pingora-panel-ops
# The group of the Panel's containers, which the socket belongs to.
SupplementaryGroups=pingora-panel
RuntimeDirectory=pingora-panel-ops
RuntimeDirectoryMode=0755
# panel-api mounts this directory; keeping it keeps the mount valid.
RuntimeDirectoryPreserve=yes
UMask=0077

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
