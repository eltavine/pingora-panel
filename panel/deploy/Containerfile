# syntax=docker/dockerfile:1

# One image with every Pingora Panel process; Compose selects the command.
# Build from the repository root:
#   docker build -f panel/deploy/Containerfile -t pingora-panel .

FROM docker.io/library/node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS web
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable
WORKDIR /panel/web
COPY panel/web/package.json panel/web/pnpm-lock.yaml panel/web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY panel/web/ ./
COPY panel/panel-api/tests/fixtures/openapi.json /panel/panel-api/tests/fixtures/openapi.json
RUN pnpm codegen && pnpm build-only

FROM docker.io/library/rust:1.98.0-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS build
# pingora-core compresses with zlib-ng, which builds with CMake.
RUN apt-get update \
 && apt-get install --yes --no-install-recommends cmake \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/panel/target \
    cargo build --manifest-path panel/Cargo.toml --release --locked \
        --bin gatewayd --bin panel-control --bin panel-bootstrap --bin ppanel --bin ops-agent \
 && mkdir -p /out/bin \
 && for binary in gatewayd panel-control panel-bootstrap ppanel ops-agent; do \
        cp "panel/target/release/$binary" /out/bin/; \
    done
# Directories that named volumes mount over; volumes inherit their owner
# and mode. The gateway runs as root and keeps its state in its own.
RUN for directory in control gateway-secrets pki credentials/panel-api \
        credentials/config-service credentials/automation-service credentials/observability-service \
        credentials/audit-service credentials/gatewayd; do \
        mkdir -p "/out/state/$directory"; \
    done \
 && chmod 700 /out/state/control \
 && mkdir -p /out/gateway \
 && chmod 700 /out/gateway

FROM gcr.io/distroless/cc-debian12:nonroot@sha256:9dac0a79194e45a7da0158a9c6da57b217585af0786db3845d1f0ec1a0dd182f
LABEL org.opencontainers.image.title="Pingora Panel" \
      org.opencontainers.image.source="https://github.com/eltavine/pingora-panel" \
      org.opencontainers.image.licenses="Apache-2.0"
COPY --from=build /out/bin/ /usr/local/bin/
COPY --from=web /panel/web/dist/ /usr/share/pingora-panel/web/
COPY --from=build --chown=65532:65532 /out/state/ /var/lib/pingora-panel/
COPY --from=build /out/gateway/ /var/lib/pingora-panel/gateway/
USER 65532:65532
