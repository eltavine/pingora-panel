# syntax=docker/dockerfile:1

# One image with every Pingora Panel process; Compose selects the command.
# Build from the repository root:
#   docker build -f panel/deploy/Containerfile -t pingora-panel .

FROM docker.io/library/node:26.9.0-bookworm-slim@sha256:582460f614631b59b824ac6020533b9bf339c7fdf3a6d7db31abb6b4065f0212 AS web
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# Node 25 and later no longer ship Corepack, which picks pnpm from package.json.
RUN npm install --global corepack@0.36.0 && corepack enable
WORKDIR /panel/web
COPY panel/web/package.json panel/web/pnpm-lock.yaml panel/web/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY panel/web/ ./
COPY panel/panel-api/tests/fixtures/openapi.json /panel/panel-api/tests/fixtures/openapi.json
RUN pnpm codegen && pnpm build-only \
 && node scripts/third-party-notices.ts >/panel/third-party-notices.md

FROM docker.io/library/rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS build
# pingora-core compresses with zlib-ng, which builds with CMake.
RUN apt-get update \
 && apt-get install --yes --no-install-recommends cmake \
 && rm -rf /var/lib/apt/lists/*
COPY .github/scripts/install-cargo-about.sh /tmp/install-cargo-about.sh
RUN bash /tmp/install-cargo-about.sh /usr/local/bin
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo install --locked --version 0.7.7 cargo-auditable
WORKDIR /src
COPY . .
COPY --from=web /panel/third-party-notices.md /tmp/third-party-notices.md
# cargo-auditable embeds the crates each binary is built from, so the image's
# SBOM and scans see them (ADR 0046). cargo-about reads every package the
# lockfile names, other platforms' included, which the build alone does not
# download.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/panel/target \
    cargo fetch --locked --manifest-path panel/Cargo.toml \
 && cargo auditable build --manifest-path panel/Cargo.toml --release --locked \
        --bin gatewayd --bin panel-control --bin panel-bootstrap --bin ppanel --bin ops-agent \
        --bin pingora-panel-reference-plugin \
 && mkdir -p /out/bin /out/doc \
 && for binary in gatewayd panel-control panel-bootstrap ppanel ops-agent \
        pingora-panel-reference-plugin; do \
        cp "panel/target/release/$binary" /out/bin/; \
    done \
 && cargo-about generate --locked --offline --manifest-path panel/Cargo.toml \
        --config panel/about.toml --output-file /out/doc/THIRD-PARTY-NOTICES.md panel/about.hbs \
 && cat /tmp/third-party-notices.md >>/out/doc/THIRD-PARTY-NOTICES.md \
 && cp LICENSE /out/doc/LICENSE \
 && cp docs/upstream-patches.md /out/doc/UPSTREAM-PATCHES.md
# Directories that named volumes mount over; volumes inherit their owner
# and mode. The gateway runs as root and keeps its state in its own.
RUN for directory in control plugins gateway-secrets pki credentials/panel-api \
        credentials/config-service credentials/automation-service credentials/observability-service \
        credentials/audit-service credentials/plugins-service credentials/gatewayd; do \
        mkdir -p "/out/state/$directory"; \
    done \
 && chmod 700 /out/state/control \
 && mkdir -p /out/gateway /out/sites \
 && chmod 700 /out/gateway

FROM gcr.io/distroless/cc-debian13:nonroot@sha256:e792ab3d241a468a4fd7519ddbbebe66b49b5f365771716ea688ad40b6c6f1c2
# The release and commit the image was built from; the control plane reports them.
ARG PINGORA_PANEL_VERSION=dev
ARG PINGORA_PANEL_COMMIT=unknown
LABEL org.opencontainers.image.title="Pingora Panel" \
      org.opencontainers.image.source="https://github.com/eltavine/pingora-panel" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${PINGORA_PANEL_VERSION}" \
      org.opencontainers.image.revision="${PINGORA_PANEL_COMMIT}"
ENV PINGORA_PANEL_VERSION=${PINGORA_PANEL_VERSION} \
    PINGORA_PANEL_COMMIT=${PINGORA_PANEL_COMMIT}
COPY --from=build /out/bin/ /usr/local/bin/
COPY --from=build /out/doc/ /usr/share/doc/pingora-panel/
COPY --from=web /panel/web/dist/ /usr/share/pingora-panel/web/
COPY --from=build --chown=65532:65532 /out/state/ /var/lib/pingora-panel/
COPY --from=build /out/gateway/ /var/lib/pingora-panel/gateway/
# The static sites, which the control plane writes and the gateway serves.
COPY --from=build --chown=65532:65532 /out/sites/ /srv/pingora-panel/sites/
USER 65532:65532
