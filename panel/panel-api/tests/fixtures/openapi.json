  "components": {
    "schemas": {
      "ActivateRequest": {
        "type": "object",
        "required": [
          "prepare_token"
        ],
        "properties": {
          "expected_active_hash": {
            "type": [
              "string",
              "null"
            ],
            "description": "Current active content hash required by compare-and-swap. Omit or use\nnull only for the first activation, when no configuration is active."
          },
          "prepare_token": {
            "type": "string"
          }
        }
      },
      "ActivatedResponse": {
        "type": "object",
        "required": [
          "revision_id",
          "content_hash"
        ],
        "properties": {
          "content_hash": {
            "type": "string"
          },
          "previous_active_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "DiagnosticDetails": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "help": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          },
          "resource_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_span": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "GatewayStatusResponse": {
        "type": "object",
        "required": [
          "ready",
          "prepared_count",
          "adapter_version",
          "schema_version"
        ],
        "properties": {
          "active_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "active_revision_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "adapter_version": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "prepared_count": {
            "type": "integer",
            "minimum": 0
          },
          "ready": {
            "type": "boolean"
          },
          "schema_version": {
            "type": "string"
          }
        }
      },
      "IdempotencyReceiptPendingResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "IdempotencyReceiptResponse": {
        "type": "object",
        "required": [
          "request_hash",
          "outcome"
        ],
        "properties": {
          "outcome": {
            "$ref": "#/components/schemas/ReceiptOutcomeResponse"
          },
          "request_hash": {
            "type": "string"
          }
        }
      },
      "PreparedResponse": {
        "type": "object",
        "required": [
          "revision_id",
          "content_hash",
          "prepare_token"
        ],
        "properties": {
          "content_hash": {
            "type": "string"
          },
          "prepare_token": {
            "type": "string"
          },
          "revision_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "field_errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiagnosticDetails"
            }
          },
          "request_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryable": {
            "type": "boolean"
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "ReceiptOutcomeResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "revision_id",
              "content_hash",
              "status"
            ],
            "properties": {
              "content_hash": {
                "type": "string"
              },
              "previous_active_hash": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "revision_id": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "enum": [
                  "succeeded"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "diagnostics",
              "status"
            ],
            "properties": {
              "diagnostics": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DiagnosticDetails"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "rejected"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "failed_before_commit"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending_reconciliation"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unknown"
                ]
              }
            }
          }
        ]
      },
      "SnapshotEnvelope": {
        "type": "object",
        "required": [
          "schema_version",
          "snapshot"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "description": "Selects the compiler/schema reader before the document is interpreted."
          },
          "snapshot": {
            "description": "Versioned source document interpreted by the injected ConfigCompiler."
          }
        }
      },
      "ValidationResponse": {
        "type": "object",
        "required": [
          "valid",
          "diagnostics"
        ],
        "properties": {
          "diagnostics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiagnosticDetails"
            }
          },
          "valid": {
            "type": "boolean"
          }
        }
      }
    }
  }
